{
	"schemaVersion": 1,
	"id": "mcdt",
	"version": "${version}",
	"name": "Minecraft DevTools",
	"description": "Local REST and WebSocket API for the live Minecraft ${minecraft_version} client.",
	"authors": [
		"Advik"
	],
	"contact": {
		"sources": "https://github.com/Advik-B/minecraft-devtools"
	},
	"license": "MIT",
	"icon": "assets/mcdt/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.advik.mcdt.platform.fabric.FabricEntrypoint"
		],
		"modmenu": [
			"dev.advik.mcdt.platform.fabric.FabricModMenuApi"
		]
	},
	"mixins": [
		"mcdt.mixins.json"
	],
	"suggests": {
		"baritone": "${baritone_version}",
		"yet_another_config_lib_v3": "*",
		"modmenu": "*"
	},
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	}
}