{
	"schemaVersion": 1,
	"id": "mcdt",
	"version": "${version}",
	"name": "Minecraft DevTools",
	"description": "Local REST and WebSocket API for the live Minecraft 1.21.4 client.",
	"authors": [
		"Advik"
	],
	"contact": {
		"sources": "https://github.com/Advik/minecraft-devtools"
	},
	"license": "CC0-1.0",
	"icon": "assets/mcdt/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.advik.mcdt.client.MinecraftDevToolsClient"
		],
		"modmenu": [
			"dev.advik.mcdt.client.config.McdtModMenuApi"
		]
	},
	"mixins": [
		"mcdt.mixins.json"
	],
	"suggests": {
		"baritone": "1.13.1",
		"yet_another_config_lib_v3": "*",
		"modmenu": "*"
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.4",
		"java": ">=21",
		"fabric-api": "*"
	}
}